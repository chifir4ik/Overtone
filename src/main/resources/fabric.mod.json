{
  "schemaVersion": 1,
  "id": "musicplayer",
  "version": "${version}",
  "name": "Overtone",
  "description": "Music in Minecraft: Yandex Music, SoundCloud and your own files, karaoke lyrics, flying words in the world and a pretty Now Playing HUD. Works from the main menu too. English, Russian, Japanese.",
  "authors": [
    "chifir4ik",
    "PabJlo"
  ],
  "contributors": [
    "Kartonek (SpotifyMusicMod)"
  ],
  "license": "MIT",
  "icon": "assets/musicplayer/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.musicplayer.MusicPlayerMod"
    ]
  },
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": ">=26.3- <26.4-"
  },
  "custom": {
    "credits": {
      "design": "SpotifyMusicMod by Kart-Modding (MIT): https://github.com/Kart-Modding/SpotifyMusicMod"
    }
  }
}
